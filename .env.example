# Copie para .env quando quiser configurar o projeto localmente.

# Vazio = diagnóstico local por regras.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_STORE_INTERACTIONS=true

# Padrão local, sem dependência externa.
DATABASE_URL=sqlite:///dataops_ai.db

# Necessário apenas ao subir o serviço PostgreSQL via Docker Compose.
POSTGRES_PASSWORD=

# PostgreSQL local via docker-compose.yml:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dataops_ai

BCB_SERIES_CODE=11
BCB_START_DATE=01/01/2024
BCB_END_DATE=31/01/2024

# Desenvolvimento: deixe vazio para executar somente localmente.
# Produção: use um segredo longo, gerado fora do repositório.
DATAOPS_API_KEY=

# Em produção, use APP_ENV=production e informe apenas as origens reais.
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

