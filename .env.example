# Copy to .env when you want local config/secrets.

# Empty = local rule-based agent diagnosis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Zero-cost local default for V1.
DATABASE_URL=sqlite:///dataops_ai.db

# PostgreSQL example for later:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dataops_ai

BCB_SERIES_CODE=11
BCB_START_DATE=01/01/2024
BCB_END_DATE=31/01/2024
